# Estas variáveis são OPCIONAIS — o app já funciona sem elas, com valores
# padrão embutidos no código (Supabase URL/anon key e VAPID public key
# são todos valores seguros para expor publicamente). Só preencha aqui se
# quiser apontar para um projeto Supabase diferente do padrão.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
